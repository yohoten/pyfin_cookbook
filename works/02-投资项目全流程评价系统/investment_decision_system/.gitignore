# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
build/
dist/
.venv/
venv/
env/

# 测试与缓存
.pytest_cache/
.cache/
.ruff_cache/
.mypy_cache/
*.pkl

# ----------------------------------------------------------------------
# 运行输出 —— 每次 python main.py 都会覆写，不入版本库
# 注意：这里写 outputs/（带斜杠）表示"整个目录忽略"，Git 不会递归进入，
#       因此不能靠 !outputs/figures/*.png 之类的否定规则来放行其中的文件。
#       交付资产请放到独立的 docs/ 目录（见 docs/README.md）。
# ----------------------------------------------------------------------
outputs/

# ----------------------------------------------------------------------
# 交付资产 —— 必须纳入版本库（实践要求 §五：提交报告 + 程序包）
# 显式写出否定规则，防止以后有人误加了 *.png / *.docx 之类的全局忽略
# ----------------------------------------------------------------------
!docs/
!docs/**
!docs/figures/*.png
!docs/data/*.csv
!docs/*.md
!docs/*.docx

# 环境变量
.env
.env.local

# IDE / 编辑器
.vscode/
.idea/
.vs/
*.swp
.workbuddy/

# 操作系统
.DS_Store
Thumbs.db
desktop.ini
